# Copy this file to .env, or just run:  node scripts/generate-env.js
# That writes .env with freshly generated random secrets. Never commit .env.

# MongoDB is the only database.
MONGODB_DATABASE=intellibiz
# Root user: only used to set the database up. The backend never uses it.
MONGODB_ROOT_USER=root
MONGODB_ROOT_PASSWORD=
# The backend's own user, limited to reading/writing the app database.
MONGODB_APP_USER=intellibiz_app
MONGODB_APP_PASSWORD=
# Host port for connecting with a tool such as Compass (bound to 127.0.0.1 only).
MONGODB_PUBLISHED_PORT=27018

# Required. Signs login tokens; the backend refuses to start if it is missing, shorter than
# 32 characters, or still a placeholder. Anyone who knows it can forge a login for any user.
JWT_SECRET=

# The first admin account, created at startup only if no admin exists yet.
# Leave the password empty to skip creating one. Sign-up alone can only create STAFF accounts.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@ceylonintellibiz.local
BOOTSTRAP_ADMIN_PASSWORD=

# The website address(es) allowed to call the API from a browser (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:8080
AI_SERVICE_URL=http://localhost:8000
