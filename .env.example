# Copy this file to .env, or just run:  node scripts/generate-env.js
# That writes .env with freshly generated random secrets. Never commit .env.

POSTGRES_DB=intellibiz
POSTGRES_USER=postgres
# Required. Used by the database and the backend.
POSTGRES_PASSWORD=

# Required. Signs login tokens; the backend refuses to start if it is missing, shorter than
# 32 characters, or still a placeholder. Anyone who knows it can forge a login for any user.
JWT_SECRET=

# The first admin account, created at startup only if no admin exists yet.
# Leave the password empty to skip creating one. Sign-up alone can only create STAFF accounts.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@ceylonintellibiz.local
BOOTSTRAP_ADMIN_PASSWORD=

NEXT_PUBLIC_API_URL=http://localhost:8080
AI_SERVICE_URL=http://localhost:8000
MONGODB_URI=mongodb://localhost:27017/intellibiz
